rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function unexpired() {
      return resource.data.expiresAt > request.time;
    }

    function isParticipant() {
      return signedIn() && request.auth.uid in resource.data.participantUids;
    }

    function isHost() {
      return isParticipant() && resource.data.hostId == request.auth.uid;
    }

    function immutableRoomFields() {
      return request.resource.data.hostId == resource.data.hostId
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.expiresAt == resource.data.expiresAt;
    }

    function createsSelfAsHost() {
      return signedIn()
        && request.resource.data.hostId == request.auth.uid
        && request.resource.data.participantUids == [request.auth.uid]
        && request.resource.data.players.size() == 1
        && request.resource.data.players[0].id == request.auth.uid
        && request.resource.data.players[0].isHost == true
        && request.resource.data.expiresAt > request.time
        && request.resource.data.expiresAt < request.time + duration.value(2, 'd');
    }

    function joinsSelf() {
      return signedIn()
        && unexpired()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['participantUids', 'players', 'preferencesReady', 'relationshipsReady'])
        && request.resource.data.participantUids
          == resource.data.participantUids.concat([request.auth.uid])
        && request.resource.data.players.size() == resource.data.players.size() + 1
        && request.resource.data.players[request.resource.data.players.size() - 1].id == request.auth.uid
        && request.resource.data.players[request.resource.data.players.size() - 1].isHost == false
        && request.resource.data.preferencesReady.diff(resource.data.preferencesReady)
          .affectedKeys().hasOnly([request.auth.uid])
        && request.resource.data.preferencesReady[request.auth.uid] is bool
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['relationshipsReady'])
          || (request.resource.data.relationshipsReady.diff(resource.data.relationshipsReady)
            .affectedKeys().hasOnly([request.auth.uid])
            && request.resource.data.relationshipsReady[request.auth.uid] == false));
    }

    function changesOwnMap(mapName) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([mapName])
        && request.resource.data[mapName].diff(resource.data[mapName])
          .affectedKeys().hasOnly([request.auth.uid]);
    }

    function changesOwnPartyMap(mapName) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['party'])
        && request.resource.data.party.diff(resource.data.party).affectedKeys().hasOnly([mapName])
        && request.resource.data.party[mapName].diff(resource.data.party[mapName])
          .affectedKeys().hasOnly([request.auth.uid]);
    }

    function submitsPrivatePreferences() {
      return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['preferencesReady', 'groupProfile'])
        && request.resource.data.preferencesReady.diff(resource.data.preferencesReady)
          .affectedKeys().hasOnly([request.auth.uid])
        && resource.data.preferencesReady[request.auth.uid] == false
        && request.resource.data.preferencesReady[request.auth.uid] == true;
    }

    function isCurrentClassicPlayer() {
      return isParticipant()
        && resource.data.currentTurnIndex < resource.data.players.size()
        && resource.data.players[resource.data.currentTurnIndex].id == request.auth.uid;
    }

    function isCurrentPartyOwner() {
      return isParticipant()
        && resource.data.party != null
        && resource.data.party.turnIndex < resource.data.players.size()
        && resource.data.players[resource.data.party.turnIndex].id == request.auth.uid;
    }

    function participantUpdate() {
      return immutableRoomFields() && (
        changesOwnMap('relationshipsReady')
        || submitsPrivatePreferences()
        || changesOwnMap('categoryVotes')
        || changesOwnPartyMap('submissions')
        || changesOwnPartyMap('done')
        || changesOwnPartyMap('votes')
        || changesOwnPartyMap('nhiAnswers')
        || changesOwnPartyMap('choiceVotes')
        || changesOwnPartyMap('ownerGuesses')
        || changesOwnPartyMap('anonymousGuesses')
        || (isCurrentClassicPlayer()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'gameState', 'currentTurnIndex', 'currentQuestion', 'currentQuestionId', 'currentCategory',
            'currentQuestionAsker', 'availableCategories', 'usedCategories', 'turnHistory'
          ]))
        || (isCurrentPartyOwner()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'party', 'gameState', 'currentTurnIndex'
          ]))
      );
    }

    match /sessions/{code} {
      allow create: if createsSelfAsHost();
      allow get: if signedIn() && unexpired();
      allow list: if false;
      allow update: if joinsSelf()
        || (isHost() && immutableRoomFields())
        || (isParticipant() && unexpired() && participantUpdate());
      allow delete: if isHost();

      match /privateProfiles/{uid} {
        allow read, create, update, delete: if signedIn()
          && request.auth.uid == uid
          && request.auth.uid in get(/databases/$(database)/documents/sessions/$(code)).data.participantUids;
      }

      match /alerts/{alertId} {
        function parentSession() {
          return get(/databases/$(database)/documents/sessions/$(code)).data;
        }

        allow create: if signedIn()
          && request.auth.uid in parentSession().participantUids
          && request.resource.data.keys().hasOnly(['toUid', 'type', 'message', 'createdAt'])
          && (request.resource.data.toUid == '*'
            || request.resource.data.toUid in parentSession().participantUids);
        allow read, delete: if signedIn()
          && (resource.data.toUid == request.auth.uid || resource.data.toUid == '*');
        allow update: if false;
      }
    }
  }
}
