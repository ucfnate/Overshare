rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isParticipant() {
      return signedIn() && request.auth.uid in resource.data.participantUids;
    }
    function isHost() {
      return signedIn() && resource.data.hostId == request.auth.uid;
    }
    function createsSelfAsHost() {
      return signedIn()
        && request.resource.data.hostId == request.auth.uid
        && request.resource.data.participantUids == [request.auth.uid]
        && request.resource.data.players.size() == 1
        && request.resource.data.players[0].id == request.auth.uid
        && request.resource.data.players[0].isHost == true;
    }

    match /sessions/{code} {
      allow create: if createsSelfAsHost();
      allow read: if signedIn();

      // Existing game modes still share one session document. Participants may
      // submit collaborative fields; host-only fields remain protected.
      allow update: if signedIn()
        && (isParticipant() || request.auth.uid in request.resource.data.participantUids)
        && request.resource.data.hostId == resource.data.hostId
        && request.resource.data.createdAt == resource.data.createdAt
        && (
          isHost()
          || !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'hostId', 'gameState', 'mode', 'currentTurnIndex', 'currentQuestion',
            'currentCategory', 'currentQuestionAsker', 'selectedCategories',
            'availableCategories', 'usedCategories', 'turnHistory', 'groupProfile'
          ])
        );
      allow delete: if isHost();

      match /alerts/{alertId} {
        allow read, delete: if signedIn();
        allow create: if signedIn();
        allow update: if false;
      }
    }
  }
}
